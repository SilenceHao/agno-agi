# DeepSeek API Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
# Set this to a DeepSeek API model ID that accepts image input.
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local knowledge-base settings. Only files explicitly imported from the Knowledge page are indexed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_DATA_DIR=D:/AI-Agent/knowledge
# Optional local LanceDB path; defaults to ./data/knowledge/vectors under the project.
# KNOWLEDGE_VECTOR_DIR=D:/AI-Agent/knowledge-vectors
